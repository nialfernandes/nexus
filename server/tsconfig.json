{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noEmit": true,
    // The tests import sibling .ts files by their full name; nothing is emitted, so the extension is safe.
    "allowImportingTsExtensions": true,
    // The Workers types and the Node types both describe a few globals (fetch, Response, crypto) and disagree about
    // some of them. Only our own .ts files are checked, so the two can sit side by side.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
