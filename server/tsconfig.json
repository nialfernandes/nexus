{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The Workers types, which describe Cloudflare's runtime. The Node types are for the tests.
    "types": ["@cloudflare/workers-types", "node"],
    // The tests import sibling .ts files by their full name; nothing is emitted, so the extension is safe.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
