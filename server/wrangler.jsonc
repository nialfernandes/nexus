{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "compatibility_date": "2026-06-01",
  "main": "src/plugs/cloudflare/worker.ts",
  // The device approval page and the Nexus page: their files in public/nexus (each page, its stylesheet and script, and three typefaces),
  // served by the Worker to whoever opens a page's link (page.ts): they hold nothing private, and each page is where the owner signs in with
  // the owner secret. They sit at the same address each is served at (the Nexus page is the folder's own, /nexus/), so `run_worker_first`
  // makes the Worker see every /nexus/* request before the asset server can hand out a file the pages are not made of (a folder, the
  // licence texts).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/nexus/*"]
  },
  // Nexus's own database: every version of every note, as the encrypted blobs the devices made, and the key wraps. Create it once with
  //   npx wrangler d1 create nexus
  // and put the id that command prints in `database_id` below. Migrations live in `migrations/`, and
  //   npx wrangler d1 migrations apply nexus --remote
  // applies them. See README.md.
  "d1_databases": [
    {
      "binding": "NEXUS_DB",
      "database_name": "nexus",
      "database_id": "REPLACE-WITH-THE-ID-FROM-WRANGLER-D1-CREATE",
      "migrations_dir": "migrations"
    }
  ],
  // The settings, each optional (src/ports.ts says what leaving each out means). The owner's secret is NOT set here:
  // it is a Worker secret, set with `npx wrangler secret put NEXUS_OWNER_SECRET`.
  //   NEXUS_OWNER    the name of the owner's identity, such as "owner". Left out, Nexus has no owner and stays closed.
  //   NEXUS_ADDRESS  the public address, such as "https://nexus.example.org". Left out, the address a request came to.
  //   NEXUS_CHANGES_PAGE_BYTES  the most blob text one page of the changes feed sends, in bytes, such as "4000000". Left out, 4000000.
  "vars": {}
}
